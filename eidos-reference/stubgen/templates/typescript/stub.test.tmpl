{{- range .Records}}
{{- $stub := .Decl}}
{{- $contract := index $stub.Implements 0}}
{{- use (printf "./%s" (trimSuffix $.Name ".test.ts")) $stub.Name}}

/** tsc checks that a {{$stub.Name}} is a {{.Data.Interface}}. */
export const check{{$stub.Name}}: {{spell $contract}} = new {{$stub.Name}}{{template "witnesses" $contract.Args}}();
{{- end}}
{{- define "witnesses"}}{{with .}}<{{range $i, $a := .}}{{if $i}}, {{end}}{{spell $a}}{{end}}>{{end}}{{end}}
