{{memberbody .}}    {{if .Returns.Len}}return {{end}}this.{{.Name}}Func!({{range $i, $p := .Params.Items}}{{if $i}}, {{end}}{{if $p.Variadic}}...{{end}}{{$p.Name}}{{end}});
  }
{{- end}}
}
