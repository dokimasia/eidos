{{- range $mock.Methods.Items}}
  /** {{.Name}}Func is the function that {{.Name}} calls. */
  {{.Name}}Func?: {{typeparams .TypeParams}}({{params .Params}}) => {{slice (returns .) 2}};
{{- end}}
{{- range $mock.Methods.Items}}

  /** {{.Name}} calls {{.Name}}Func. */
