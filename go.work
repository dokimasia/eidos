go 1.27.2

// The repository root module (go.dokimi.dev/eidos) is deliberately
// absent: it has no packages and exists only to anchor the module
// path. CI installs the Go of the go line above. Every ergon
// per-module command iterates the list below.
use (
	./eidos-cli
	./eidos-conformance
	./eidos-core
	./eidos-lang
	./eidos-lang-go
	./eidos-lang-java
	./eidos-lang-kotlin
	./eidos-lang-php
	./eidos-lang-protobuf
	./eidos-lang-rust
	./eidos-lang-typescript
	./eidos-plugin-shape
	./eidos-plugin-shape/tools
	./eidos-reference
	./eidos-sdk
)
