go 1.27.2

// The repository root module (go.dokimi.dev/eidos) is deliberately
// absent: it has no packages and exists only to anchor the module
// path. CI installs the Go of the go line above. Every ergon
// per-module command iterates the list below.
use (
	./eidos-cli
	./eidos-conformance
	./eidos-core
	./eidos-declarative
	./eidos-lang
	./eidos-lang-go
	./eidos-lang-java
	./eidos-lang-kotlin
	./eidos-lang-php
	./eidos-lang-protobuf
	./eidos-lang-rust
	./eidos-lang-typescript
	./eidos-plugin-shape
	./eidos-plugin-shape/tools
	./eidos-reference
	./eidos-sdk
)

replace go.dokimi.dev/eidos/cli v0.1.0 => ./eidos-cli

replace go.dokimi.dev/eidos/core v0.1.0 => ./eidos-core

replace go.dokimi.dev/eidos/declarative v0.1.0 => ./eidos-declarative

replace go.dokimi.dev/eidos/lang v0.1.0 => ./eidos-lang

replace go.dokimi.dev/eidos/lang/go v0.1.0 => ./eidos-lang-go

replace go.dokimi.dev/eidos/lang/java v0.1.0 => ./eidos-lang-java

replace go.dokimi.dev/eidos/lang/protobuf v0.1.0 => ./eidos-lang-protobuf

replace go.dokimi.dev/eidos/lang/rust v0.1.0 => ./eidos-lang-rust

replace go.dokimi.dev/eidos/lang/typescript v0.1.0 => ./eidos-lang-typescript

replace go.dokimi.dev/eidos/plugin/shape v0.0.1 => ./eidos-plugin-shape

replace go.dokimi.dev/eidos/sdk v0.1.0 => ./eidos-sdk
