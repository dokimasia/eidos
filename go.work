go 1.27.3

// The repository root module (go.dokimi.dev/eidos) contains the command
// eidos. Its go.mod has no replace directive, so go install builds the
// command from published modules. CI installs the Go of the go line
// above. Every ergon per-module command iterates the list below.
use (
	.
	./eidos-cli
	./eidos-conformance
	./eidos-core
	./eidos-declarative
	./eidos-lang
	./eidos-lang-go
	./eidos-lang-graphql
	./eidos-lang-java
	./eidos-lang-kotlin
	./eidos-lang-php
	./eidos-lang-protobuf
	./eidos-lang-python
	./eidos-lang-rust
	./eidos-lang-typescript
	./eidos-plugin-shape
	./eidos-plugin-shape/tools
	./eidos-reference
	./eidos-sdk
)

replace go.dokimi.dev/eidos/cli v0.3.2 => ./eidos-cli

replace go.dokimi.dev/eidos/core v0.10.0 => ./eidos-core

replace go.dokimi.dev/eidos/declarative v0.1.9 => ./eidos-declarative

replace go.dokimi.dev/eidos/lang v0.3.3 => ./eidos-lang

replace go.dokimi.dev/eidos/lang/go v0.6.0 => ./eidos-lang-go

replace go.dokimi.dev/eidos/lang/graphql v0.1.7 => ./eidos-lang-graphql

replace go.dokimi.dev/eidos/lang/java v0.2.7 => ./eidos-lang-java

replace go.dokimi.dev/eidos/lang/protobuf v0.2.7 => ./eidos-lang-protobuf

replace go.dokimi.dev/eidos/lang/python v0.1.7 => ./eidos-lang-python

replace go.dokimi.dev/eidos/lang/rust v0.2.7 => ./eidos-lang-rust

replace go.dokimi.dev/eidos/lang/typescript v0.4.3 => ./eidos-lang-typescript

replace go.dokimi.dev/eidos/plugin/shape v0.0.10 => ./eidos-plugin-shape

replace go.dokimi.dev/eidos/sdk v0.7.1 => ./eidos-sdk
