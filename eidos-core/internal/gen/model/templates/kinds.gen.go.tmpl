{{template "header" .}}
import (
	"go.dokimi.dev/eidos/core/position"
	"go.dokimi.dev/eidos/core/symbol"
)
{{range .Views}}{{$v := .}}
{{- range .Doc}}
// {{.}}
{{- end}}
//
// This is the {{$.Package}} spelling of the kind.
type {{.Name}} struct {
{{- range .Fields}}
{{- range .Doc}}
	// {{.}}
{{- end}}
	{{.Storage}} {{.Decl}} `json:"{{.JSONName}},omitzero"`{{if .Comment}} // {{.Comment}}{{end}}
{{- end}}
}

// Kind returns [symbol.Kind{{.Name}}].
func (x *{{.Name}}) Kind() symbol.Kind { return symbol.Kind{{.Name}} }

// Position returns where the declaration was written.
func (x *{{.Name}}) Position() position.Pos { return {{.PosExpr}} }

// Docs returns the documentation of the declaration, or nil when it
// has none.
func (x *{{.Name}}) Docs() []string { return {{.DocExpr}} }
{{- if .IDStorage}}

// Identity returns the canonical identity of the declaration. It is
// zero until the resolution step assigns one.
func (x *{{.Name}}) Identity() symbol.Identity { return x.{{.IDStorage}} }
{{- else if .ZeroIdentity}}

// Identity returns the zero identity. The kind does not declare an
// identity field, because it is not a declaration.
func (x *{{.Name}}) Identity() symbol.Identity { return symbol.Identity{} }
{{- end}}
{{- range .Members}}

// {{.Method}} returns the member list, adapted for neutral code.
{{- if not .Items}} This kind has no such list, so it returns nil.
{{- end}}
func (x *{{$v.Name}}) {{.Method}}() []symbol.Symbol {
{{- if .Items}}
	out := make([]symbol.Symbol, 0, {{.Len}})
	for _, member := range {{.Items}} {
		out = append(out, member)
	}
	return out
{{- else}}
	return nil
{{- end}}
}
{{- end}}
{{- if .TypeRefStorage}}

// TypeRef returns the type reference of the declaration, or nil when
// the declaration has none.
func (x *{{.Name}}) TypeRef() symbol.Symbol {
	if x.{{.TypeRefStorage}} == nil {
		return nil
	}
	return x.{{.TypeRefStorage}}
}
{{- end}}
{{end}}
