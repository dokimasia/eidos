{{template "header" .}}
import (
	"testing"

	"go.dokimi.dev/assert"
	"go.dokimi.dev/assert/bench"
	"go.dokimi.dev/eidos/core/position"
	"go.dokimi.dev/eidos/core/symbol"
{{- template "model" .}}
)

// Every kind satisfies the vocabulary's interfaces. The assertions
// fail to compile rather than to run, which is where an unsatisfied
// interface belongs.
var (
{{- range .Views}}
	_ symbol.Symbol = (*{{.Name}})(nil)
{{- end}}
{{- range .Views}}
{{- if .IsMembered}}
	_ symbol.Membered = (*{{.Name}})(nil)
{{- end}}
{{- end}}
{{- range .Views}}
{{- if .TypeRefStorage}}
	_ symbol.Typed = (*{{.Name}})(nil)
{{- end}}
{{- end}}
{{- if .Identified}}
{{- range .Views}}
	_ Declaration = (*{{.Name}})(nil)
{{- end}}
{{- end}}
)

// The values the accessor cases give a subject: a position, two
// lines of documentation and an identity.
var (
	kindsAt    = position.Pos{File: "svc/store.go", Line: 41, Col: 2}
	kindsLines = []string{"one", "two"}
	kindsID    = symbol.Identity{Lang: "golang", Package: "svc/store", Name: "Store"}
)

// kindsCase is one measured call of one kind's accessor: the
// sub-benchmark's name, its allocation ceiling, the call, and the
// check on what the last call returned.
type kindsCase struct {
	name   string
	allocs uint64
	call   func()
	check  func(testing.TB)
}

// Every kind implements the shared vocabulary: it returns its own
// kind, where it was written, its documentation, its identity, its
// type reference and its member lists.
func TestKinds(t *testing.T) {
	t.Parallel()

	t.Run("Kind", func(t *testing.T) {
		t.Parallel()

		tests := []struct {
			subject symbol.Symbol
			want    symbol.Kind
		}{
{{- range .Views}}
			{subject: &{{.Name}}{}, want: symbol.Kind{{.Name}}},
{{- end}}
		}
		for _, tt := range tests {
			t.Run("returns "+tt.want.String()+" for its kind", func(t *testing.T) {
				t.Parallel()

				assert.Equal(t, tt.subject.Kind(), tt.want,
					"every kind returns its own constant")
			})
		}
	})

	t.Run("Position", func(t *testing.T) {
		t.Parallel()

		t.Run("returns where the declaration was written", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .HasPos}}

			assert.Equal(t, (&{{.Name}}{Pos: kindsAt}).Position(), kindsAt,
				"a located {{.Name}} returns where it was written")
{{- else}}

			assert.Equal(t, (&{{.Name}}{}).Position(), position.Pos{},
				"a {{.Name}} carries no position and returns the zero position")
{{- end}}
{{- end}}
		})
	})

	t.Run("Docs", func(t *testing.T) {
		t.Parallel()

		t.Run("returns the declaration's documentation", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .HasDoc}}

			assert.Length(t, (&{{.Name}}{Doc: kindsLines}).Docs(), len(kindsLines),
				"a documented {{.Name}} returns its documentation")
{{- else}}

			assert.Nil(t, (&{{.Name}}{}).Docs(),
				"a {{.Name}} carries no documentation and returns nil")
{{- end}}
{{- end}}
		})
	})
{{- if .Identified}}

	t.Run("Identity", func(t *testing.T) {
		t.Parallel()

		t.Run("returns the identity the resolution step assigned", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .IDStorage}}

			assert.Equal(t, (&{{.Name}}{ID: kindsID}).Identity(), kindsID,
				"a named {{.Name}} returns the identity it was assigned")
{{- end}}
{{- end}}
		})

		t.Run("returns the zero identity before it is assigned", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .IDStorage}}

			assert.Equal(t, (&{{.Name}}{}).Identity(), symbol.Identity{},
				"an unassigned {{.Name}} returns the zero identity")
{{- end}}
{{- end}}
		})
	})
{{- end}}

	t.Run("TypeRef", func(t *testing.T) {
		t.Parallel()

		t.Run("returns nil when the source states no type", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .TypeRefStorage}}

			assert.Nil(t, (&{{.Name}}{}).TypeRef(),
				"a {{.Name}} stating no type returns nil")
{{- end}}
{{- end}}
		})

		t.Run("returns the declared type reference", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .TypeRefStorage}}

			assert.NotNil(t, (&{{.Name}}{Type: &TypeRef{}}).TypeRef(),
				"a {{.Name}} stating a type returns the declared reference")
{{- end}}
{{- end}}
		})
	})
{{- $views := .Views}}
{{- range $method := memberMethods}}

	t.Run("{{$method}}", func(t *testing.T) {
		t.Parallel()

		t.Run("returns nil for a kind without the list", func(t *testing.T) {
			t.Parallel()
{{- range $views}}{{$v := .}}
{{- range .Members}}
{{- if and (eq .Method $method) (not .Items)}}

			assert.Nil(t, (&{{$v.Name}}{}).{{$method}}(),
				"a {{$v.Name}} has no such list and returns nil")
{{- end}}
{{- end}}
{{- end}}
		})

		t.Run("returns the members of a kind with the list", func(t *testing.T) {
			t.Parallel()
{{- range $views}}{{$v := .}}
{{- range .Members}}
{{- if and (eq .Method $method) .Items}}

			{
				subject := &{{$v.Name}}{}
{{- range $v.Children}}
				{{.}}
{{- end}}
				assert.NotEmpty(t, subject.{{$method}}(),
					"a {{$v.Name}} returns the members it has")
			}
{{- end}}
{{- end}}
{{- end}}
		})
	})
{{- end}}
}

// The accessors allocate within their ceilings in the ordinary run,
// which runs no benchmark: a member list allocates its one slice, and
// every other accessor nothing.
func TestKindsAllocs(t *testing.T) {
	for _, tt := range kindsCases() {
		assert.MaxAllocs(t, tt.call, tt.allocs, tt.name+" allocates within its ceiling")
		tt.check(t)
	}
}

// BenchmarkKinds measures every accessor of every kind over a
// populated subject.
func BenchmarkKinds(b *testing.B) {
	for _, tt := range kindsCases() {
		b.Run(tt.name, func(b *testing.B) {
			c := bench.Start(b).MaxAllocs(tt.allocs)
			defer c.End()
			for c.Loop() {
				tt.call()
			}
			tt.check(b)
		})
	}
}

// kindsCases returns one case for every accessor of every kind, each
// over a subject with a position, documentation, an identity, a type
// reference and one child in every traversed field.
func kindsCases() []kindsCase {
	var cases []kindsCase
{{- range .Views}}{{$v := .}}
	{
		subject := &{{.Name}}{}
{{- if .HasPos}}
		subject.Pos = kindsAt
{{- end}}
{{- if .HasDoc}}
		subject.Doc = kindsLines
{{- end}}
{{- if .IDStorage}}
		subject.{{.IDStorage}} = kindsID
{{- end}}
{{- range .Children}}
		{{.}}
{{- end}}
{{- if .TypeRefStorage}}
		subject.{{.TypeRefStorage}} = &TypeRef{}
{{- end}}
		var (
			kind symbol.Kind
			pos  position.Pos
			docs []string
{{- if .IDStorage}}
			id symbol.Identity
{{- end}}
{{- if .TypeRefStorage}}
			typed symbol.Symbol
{{- end}}
{{- if .IsMembered}}
			members []symbol.Symbol
{{- end}}
		)
		cases = append(cases,
			kindsCase{
				name: "{{.Name}}.Kind",
				call: func() { kind = subject.Kind() },
				check: func(tb testing.TB) {
					assert.Equal(tb, kind, symbol.Kind{{.Name}}, "Kind returns the kind's constant")
				},
			},
			kindsCase{
				name: "{{.Name}}.Position",
				call: func() { pos = subject.Position() },
				check: func(tb testing.TB) {
{{- if .HasPos}}
					assert.Equal(tb, pos, kindsAt, "Position returns where the declaration was written")
{{- else}}
					assert.Equal(tb, pos, position.Pos{}, "Position returns the zero position")
{{- end}}
				},
			},
			kindsCase{
				name: "{{.Name}}.Docs",
				call: func() { docs = subject.Docs() },
				check: func(tb testing.TB) {
{{- if .HasDoc}}
					assert.Length(tb, docs, len(kindsLines), "Docs returns the documentation")
{{- else}}
					assert.Nil(tb, docs, "Docs returns nil")
{{- end}}
				},
			},
{{- if .IDStorage}}
			kindsCase{
				name: "{{.Name}}.Identity",
				call: func() { id = subject.Identity() },
				check: func(tb testing.TB) {
					assert.Equal(tb, id, kindsID, "Identity returns the assigned identity")
				},
			},
{{- end}}
{{- if .TypeRefStorage}}
			kindsCase{
				name: "{{.Name}}.TypeRef",
				call: func() { typed = subject.TypeRef() },
				check: func(tb testing.TB) {
					assert.NotNil(tb, typed, "TypeRef returns the declared reference")
				},
			},
{{- end}}
{{- range .Members}}
			kindsCase{
				name: "{{$v.Name}}.{{.Method}}",
{{- if .Items}}
				allocs: 1,
{{- end}}
				call: func() { members = subject.{{.Method}}() },
				check: func(tb testing.TB) {
{{- if .Items}}
					assert.NotEmpty(tb, members, "{{.Method}} returns the members")
{{- else}}
					assert.Nil(tb, members, "{{.Method}} returns nil")
{{- end}}
				},
			},
{{- end}}
		)
	}
{{- end}}
	return cases
}
