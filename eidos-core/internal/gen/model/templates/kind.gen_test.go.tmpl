{{template "header" .}}
import (
	"testing"

	"go.dokimi.dev/assert"
)

// kindNamings pairs every kind with the name it returns, which is
// what String writes and ParseKind reads back.
var kindNamings = []struct {
	kind Kind
	want string
}{
	{kind: KindInvalid, want: "Invalid"},
{{- range .Kinds}}
	{kind: Kind{{.Name}}, want: "{{.Name}}"},
{{- end}}
}

func TestKind(t *testing.T) {
	t.Parallel()

	t.Run("String", func(t *testing.T) {
		t.Parallel()

		for _, tt := range kindNamings {
			t.Run(tt.want, func(t *testing.T) {
				t.Parallel()
				assert.Equal(t, tt.kind.String(), tt.want,
					"the kind spells its schema name")
			})
		}

		t.Run("names are unique", func(t *testing.T) {
			t.Parallel()

			seen := make(map[string]struct{}, len(kindNamings))
			for _, tt := range kindNamings {
				seen[tt.want] = struct{}{}
			}
			assert.Length(t, seen, len(kindNamings),
				"every kind returns its own name")
		})

		t.Run("a value outside the set returns a placeholder", func(t *testing.T) {
			t.Parallel()

			outside := Kind(len(kindNamings) + 1)
			assert.NotEqual(t, outside.String(), "",
				"a value outside the set returns a placeholder")
		})
	})

	t.Run("ParseKind", func(t *testing.T) {
		t.Parallel()

		t.Run("returns the kind a name spells", func(t *testing.T) {
			t.Parallel()

			for _, tt := range kindNamings {
				if tt.kind == KindInvalid {
					continue
				}
				t.Run(tt.want, func(t *testing.T) {
					t.Parallel()

					got, known := ParseKind(tt.want)
					assert.True(t, known, "a name a kind carries parses")
					assert.Equal(t, got, tt.kind, "to the kind that carries it")
				})
			}
		})

		// The pair is what lets a kind cross a boundary carrying
		// names: whatever String writes, ParseKind has to read back.
		t.Run("inverts String for every kind", func(t *testing.T) {
			t.Parallel()

			for _, tt := range kindNamings {
				if tt.kind == KindInvalid {
					continue
				}
				got, known := ParseKind(tt.kind.String())
				assert.True(t, known, "whatever String writes, ParseKind reads back")
				assert.Equal(t, got, tt.kind, "to the same kind")
			}
		})

		t.Run("returns KindInvalid when it refuses", func(t *testing.T) {
			t.Parallel()

			// A caller that drops the boolean must not receive a
			// usable kind, so the refusal returns the zero value
			// rather than whatever the lookup left behind.
			got, known := ParseKind("Nonexistent")
			assert.False(t, known, "a name no kind carries is refused")
			assert.Equal(t, got, KindInvalid,
				"and a caller that drops the boolean holds no usable kind")
		})

		t.Run("refuses a name no kind claims", func(t *testing.T) {
			t.Parallel()

			// A kind's name is its Go type name, matched exactly:
			// nothing trims, folds case or accepts a near miss.
			tests := []struct {
				name string
				why  string
			}{
				{name: "", why: "the empty name"},
				{name: "Nonexistent", why: "a name no kind carries"},
				{name: "struct", why: "the lowered spelling"},
				{name: "STRUCT", why: "the upper spelling"},
				{name: " Struct", why: "a leading space"},
				{name: "Struct ", why: "a trailing space"},
				{name: "Struct\n", why: "a trailing newline"},
				{name: "Invalid", why: "the placeholder String stands in for a non-kind"},
				{name: "Kind(0)", why: "the placeholder String stands in outside the set"},
			}
			for _, tt := range tests {
				t.Run(tt.why, func(t *testing.T) {
					t.Parallel()

					_, known := ParseKind(tt.name)
					assert.False(t, known,
						"a name is matched exactly: nothing trims, folds case "+
							"or accepts a near miss")
				})
			}
		})
	})
}
