// namesVisits is how many names a respell over every named kind's
// subject offers: each subject's own name and one per descent field.
const namesVisits = 0{{range .Views}}{{if or .NameStorage .NameWalked}} + {{.NameVisits}}{{end}}{{end}}

// Every declared name respells through the traversal: each kind's
// own name under its host and visibility, with the declaration it
// belongs to, and one name per descent field.
func TestNames(t *testing.T) {
	t.Parallel()

	t.Run("RespellNames", func(t *testing.T) {
		t.Parallel()
{{- range .Views}}
{{- if or .NameStorage .NameWalked}}

		t.Run("offers each declared name of kind {{.Name}} once", func(t *testing.T) {
			t.Parallel()

			subject := &{{.Name}}{}
{{- if .NameStorage}}
			subject.{{.NameStorage}} = "alpha"
{{- end}}
{{- if and .NameStorage .VisStorage}}
			subject.{{.VisStorage}} = symbol.VisibilityInternal
{{- end}}
{{- range .NameChildren}}
			{{.}}
{{- end}}
			var hosts []symbol.Kind
			var seen []symbol.Visibility
			err := RespellNames(subject,
				func(host, _ symbol.Symbol, _ symbol.Kind, v symbol.Visibility, name string) (string, error) {
					hosts = append(hosts, hostKind(host))
					seen = append(seen, v)
					return strings.ToUpper(name), nil
				})
			assert.NoError(t, err, "the traversal completes")
			assert.Equal(t, len(hosts), {{.NameVisits}}, "every declared name visits once")
{{- if .NameStorage}}
			assert.Equal(t, subject.{{.NameStorage}}, "ALPHA", "the settled spelling writes back")
			assert.Equal(t, hosts[0], symbol.KindInvalid, "the top level has no host")
{{- if .VisStorage}}
			assert.Equal(t, seen[0], symbol.VisibilityInternal,
				"the hook receives the carrier's visibility")
{{- end}}
{{- end}}
			for i, h := range hosts {
				if {{if .NameStorage}}i == 0{{else}}false{{end}} {
					continue
				}
				_ = i
				assert.Equal(t, h, symbol.Kind{{.Name}},
					"a member's host is its enclosing kind")
			}
			_ = seen
		})

		t.Run("offers each declared name of kind {{.Name}} with the declaration it belongs to", func(t *testing.T) {
			t.Parallel()

			subject := &{{.Name}}{}
{{- if .NameStorage}}
			subject.{{.NameStorage}} = "alpha"
{{- end}}
{{- range .NameChildren}}
			{{.}}
{{- end}}
			var carriers []symbol.Symbol
			var kinds []symbol.Kind
			err := RespellNames(subject,
				func(_, carrier symbol.Symbol, kind symbol.Kind, _ symbol.Visibility, name string) (string, error) {
					carriers = append(carriers, carrier)
					kinds = append(kinds, kind)
					return name, nil
				})
			assert.NoError(t, err, "the traversal completes")
			for i, c := range carriers {
				assert.Equal(t, c.Kind(), kinds[i], "the carrier is the declaration the name belongs to")
			}
{{- if .NameStorage}}
			assert.Equal(t, carriers[0], symbol.Symbol(subject), "the top-level name belongs to the subject")
{{- end}}
		})

		t.Run("stops at the hook's first refusal in kind {{.Name}}", func(t *testing.T) {
			t.Parallel()

			// The hook refuses at each visit in turn, so every place
			// the traversal can return an error from is one of these
			// rounds: the carrier's own name, then one per descent.
			boom := errors.New("boom")
			for stop := 1; stop <= {{.NameVisits}}; stop++ {
				subject := &{{.Name}}{}
{{- if .NameStorage}}
				subject.{{.NameStorage}} = "alpha"
{{- end}}
{{- range .NameChildren}}
				{{.}}
{{- end}}
				calls := 0
				err := RespellNames(subject,
					func(_, _ symbol.Symbol, _ symbol.Kind, _ symbol.Visibility, name string) (string, error) {
						calls++
						if calls == stop {
							return "", boom
						}
						return strings.ToUpper(name), nil
					})
				assert.True(t, errors.Is(err, boom),
					"the refusal returns from however deep it was raised")
				assert.Equal(t, calls, stop,
					"and no name after it is offered: the first error stops the traversal")
			}
		})
{{- end}}
{{- end}}
{{- with firstNamed .Views}}

		t.Run("returns the hook's error", func(t *testing.T) {
			t.Parallel()

			subject := &{{.Name}}{ {{.NameStorage}}: "alpha"}
			boom := errors.New("boom")
			err := RespellNames(subject,
				func(_, _ symbol.Symbol, _ symbol.Kind, _ symbol.Visibility, _ string) (string, error) {
					return "", boom
				})
			assert.True(t, errors.Is(err, boom), "the first error returns")
			assert.Equal(t, subject.{{.NameStorage}}, "alpha", "and the name is left as it was")
		})

		t.Run("skips an empty name", func(t *testing.T) {
			t.Parallel()

			calls := 0
			err := RespellNames(&{{.Name}}{},
				func(_, _ symbol.Symbol, _ symbol.Kind, _ symbol.Visibility, name string) (string, error) {
					calls++
					return name, nil
				})
			assert.NoError(t, err, "an unnamed carrier walks clean")
			assert.Equal(t, calls, 0, "and offers nothing to respell")
		})

		t.Run("walks nothing for a nil symbol", func(t *testing.T) {
			t.Parallel()

			err := RespellNames(nil,
				func(_, _ symbol.Symbol, _ symbol.Kind, _ symbol.Visibility, name string) (string, error) {
					return name, nil
				})
			assert.NoError(t, err, "nothing to walk is not a fault")
		})
{{- end}}
	})
}

// The traversal allocates nothing in the ordinary run, which runs no
// benchmark, when the hook returns each name as it is.
func TestNamesZeroAlloc(t *testing.T) {
	subjects := namesSubjects()
	var visits int
	same := sameName(&visits)
	assert.MaxAllocs(t, func() {
		visits = 0
		respellEvery(t, subjects, same)
	}, 0, "RespellNames allocates nothing")
	assert.Equal(t, visits, namesVisits, "RespellNames offers every declared name")
}

// BenchmarkNames measures the respell traversal over every named
// kind, with a hook that returns each name as it is, so the number is
// the traversal's own.
func BenchmarkNames(b *testing.B) {
	subjects := namesSubjects()

	b.Run("RespellNames/every named kind", func(b *testing.B) {
		var visits int
		same := sameName(&visits)
		c := bench.Start(b).MaxAllocs(0)
		defer c.End()
		for c.Loop() {
			visits = 0
			respellEvery(b, subjects, same)
		}
		assert.Equal(b, visits, namesVisits, "RespellNames offers every declared name")
	})
}

// hostKind reads a host's kind the way the settle does, with the
// invalid kind at the top level.
func hostKind(host symbol.Symbol) symbol.Kind {
	if host == nil {
		return symbol.KindInvalid
	}
	return host.Kind()
}

// sameName returns a respell hook that counts each offered name into
// visits and returns the name as it is.
func sameName(visits *int) func(host, carrier symbol.Symbol, kind symbol.Kind, v symbol.Visibility, name string) (string, error) {
	return func(_, _ symbol.Symbol, _ symbol.Kind, _ symbol.Visibility, name string) (string, error) {
		*visits++
		return name, nil
	}
}

// respellEvery respells every subject through the hook, and fails the
// test where the traversal returns an error.
func respellEvery(
	tb testing.TB,
	subjects []symbol.Symbol,
	hook func(host, carrier symbol.Symbol, kind symbol.Kind, v symbol.Visibility, name string) (string, error),
) {
	for _, s := range subjects {
		if err := RespellNames(s, hook); err != nil {
			tb.Fatalf("RespellNames: unexpected error: %v", err)
		}
	}
}

// namesSubjects returns a subject of every kind that declares a name
// or leads to one, each named and with one named child per descent
// field.
func namesSubjects() []symbol.Symbol {
	var out []symbol.Symbol
{{- range .Views}}
{{- if or .NameStorage .NameWalked}}
	{
		subject := &{{.Name}}{}
{{- if .NameStorage}}
		subject.{{.NameStorage}} = "alpha"
{{- end}}
{{- range .NameChildren}}
		{{.}}
{{- end}}
		out = append(out, subject)
	}
{{- end}}
{{- end}}
	return out
}
