// errRefused is the error [refusing] returns, so a case can tell an
// encoder's own fault from an error the codec added.
var errRefused = errors.New("{{.Package}}: the encoder refused")

// jsonFixedPoint is the property [FuzzDecodeJSON] and its ForAll twin
// in [TestSymbols] state.
const jsonFixedPoint = "DecodeJSON must return an error or a declaration whose encoding " +
	"decodes and encodes to the same bytes again"
{{- if .Identified}}

// The shape of the package the allocation cases encode: 10 files of
// 20 declarations, one package of the canonical corpus.
const (
	symbolsFiles = 10
	symbolsDecls = 20
)
{{- end}}

// The JSON codec's allocations over the cases' input, the same in each
// of 10 runs: encoding/json's encoder and decoder state, boxed values
// and buffers, and the decoded declarations' own values.
const (
	symbolsEncodeAllocs    = {{if .Identified}}859{{else}}156{{end}}
	symbolsDecodeAllocs    = {{if .Identified}}910{{else}}130{{end}}
	symbolsMarshalAllocs   = {{if .Identified}}248{{else}}158{{end}}
	symbolsUnmarshalAllocs = {{if .Identified}}181{{else}}160{{end}}
)

// symbolsPoolAllocs is the headroom of a JSON ceiling. encoding/json
// takes its buffers from pools per processor, which a collection or a
// move of the goroutine to another processor empties. Over 40 runs of
// one iteration after a warm call, an encoding allocated up to 2 more
// than the mean and a decode up to 4 more. The headroom is twice that.
const symbolsPoolAllocs = 8

// refusing is a declaration whose encoder always fails.
//
// Every kind in the model encodes, so only a declaration from
// outside the model exercises the encode path's error return.
type refusing struct{}

// Kind returns the first kind of the model.
func (refusing) Kind() symbol.Kind { return symbol.Kind{{(index .Views 0).Name}} }

// Position returns the zero position.
func (refusing) Position() position.Pos { return position.Pos{} }

// Docs returns nil.
func (refusing) Docs() []string { return nil }

// MarshalJSON always returns errRefused, which gives [EncodeJSON] an
// encoder fault to report.
func (refusing) MarshalJSON() ([]byte, error) { return nil, errRefused }

// symbolsCase is one measured call of the JSON codec: the function it
// calls and the case it measures, which name its sub-benchmark, its
// allocation ceiling, the call, and the check on what the last call
// returned.
type symbolsCase struct {
	method string
	name   string
	allocs uint64
	call   func()
	check  func(testing.TB)
}

// The JSON codec writes every declaration with its kind, so a decoder
// can place it, and reads back what it wrote.
func TestSymbols(t *testing.T) {
	t.Parallel()

	t.Run("EncodeJSON", func(t *testing.T) {
		t.Parallel()

		t.Run("encodes a nil declaration as null", func(t *testing.T) {
			t.Parallel()

			got, err := EncodeJSON(nil)
			assert.NoError(t, err, "a nil declaration encodes")
			assert.Equal(t, string(got), "null", "as JSON null")
		})

		t.Run("writes the kind on every declaration", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}

			{
				encoded, err := EncodeJSON(&{{.Name}}{})
				assert.NoError(t, err, "every kind encodes")
				expect.Contains(t, string(encoded), `"kind":"{{.Name}}"`,
					"with its kind, so a decoder can place it")
			}
{{- end}}
		})

		t.Run("leaves the kind out of a concretely typed field", func(t *testing.T) {
			t.Parallel()

			// The struct tags encode a concretely typed field on their
			// own, so only Symbols writes a discriminator.
			encoded, err := json.Marshal(&{{(index .Views 0).Name}}{})
			assert.NoError(t, err, "a concrete field marshals through its tags")
			assert.NotContains(t, string(encoded), `"kind"`,
				"and needs no discriminator")
		})

		t.Run("returns the fault a declaration's own encoder raised", func(t *testing.T) {
			t.Parallel()

			_, err := EncodeJSON(refusing{})
			assert.ErrorIs(t, err, errRefused, "the encoder's fault returns")
			assert.Contains(t, err.Error(), "{{.Model}}: encode ",
				"named for the package and the kind it was encoding")
		})
	})

	t.Run("MarshalJSON", func(t *testing.T) {
		t.Parallel()

		t.Run("writes the kind on every element", func(t *testing.T) {
			t.Parallel()

			encoded, err := Symbols{&{{(index .Views 0).Name}}{}}.MarshalJSON()
			assert.NoError(t, err, "the list encodes")
			assert.Contains(t, string(encoded), `"kind":"{{(index .Views 0).Name}}"`,
				"each element in front of the fields its own tags produce")
		})

		t.Run("returns the fault an element raised", func(t *testing.T) {
			t.Parallel()

			_, err := Symbols{refusing{}}.MarshalJSON()
			assert.ErrorIs(t, err, errRefused,
				"one element the encoder refuses fails the whole list, "+
					"rather than encoding a list missing an entry")
		})

		t.Run("encodes a nil list as null", func(t *testing.T) {
			t.Parallel()

			var none Symbols
			encoded, err := none.MarshalJSON()
			assert.NoError(t, err, "a nil list encodes")
			assert.Equal(t, string(encoded), "null", "as JSON null")
			var decoded Symbols
			assert.NoError(t, json.Unmarshal(encoded, &decoded), "which unmarshals")
			assert.Nil(t, decoded, "back to nil, so the value round-trips")
		})

		t.Run("encodes an empty list as an array", func(t *testing.T) {
			t.Parallel()

			encoded, err := Symbols{}.MarshalJSON()
			assert.NoError(t, err, "an empty list encodes")
			assert.Equal(t, string(encoded), "[]", "as an empty array")
		})
	})

	t.Run("DecodeJSON", func(t *testing.T) {
		t.Parallel()

		t.Run("round-trips every kind", func(t *testing.T) {
			t.Parallel()

			subjects := []symbol.Symbol{
{{- range .Views}}
				&{{.Name}}{},
{{- end}}
			}
			for _, subject := range subjects {
				t.Run(subject.Kind().String(), func(t *testing.T) {
					t.Parallel()

					assert.RoundTrip(t, EncodeJSON, DecodeJSON, subject,
						"DecodeJSON returns the declaration EncodeJSON encoded", assert.EquateEmpty())
					encoded, err := EncodeJSON(subject)
					assert.NoError(t, err, "the kind encodes")
					assert.RoundTrip(t, DecodeJSON, EncodeJSON, encoded,
						"EncodeJSON returns the bytes DecodeJSON decoded: the round trip is a fixed point")
				})
			}
		})

		t.Run("round-trips a populated declaration with its children", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				expect.RoundTrip(t, EncodeJSON, DecodeJSON, symbol.Symbol(subject),
					"DecodeJSON returns a {{.Name}} with every child the original has", assert.EquateEmpty())
			}
{{- end}}
{{- end}}
		})

		t.Run("reads a kind wherever another writer placed it", func(t *testing.T) {
			t.Parallel()

			for _, data := range []string{
				`{"name":"","kind":"{{(index .Views 0).Name}}"}`,
				" \n" + `{"kind":"{{(index .Views 0).Name}}"}`,
			} {
				decoded, err := DecodeJSON([]byte(data))
				assert.NoError(t, err, "an encoding EncodeJSON did not write still decodes: "+data)
				expect.Equal(t, decoded.Kind(), symbol.Kind{{(index .Views 0).Name}},
					"to the kind it names")
			}
		})

		t.Run("returns an error for an encoding it cannot place", func(t *testing.T) {
			t.Parallel()

			tests := []struct {
				name string
				data string
			}{
				{name: "no kind", data: `{"name":"Store"}`},
				{name: "unknown kind", data: `{"kind":"Nonexistent"}`},
				{name: "an escaped kind", data: `{"kind":"No\"pe"}`},
				{name: "a kind prefix over a broken body", data: `{"kind":"{{(index .Views 0).Name}}",`},
				{name: "not an object", data: `[]`},
{{- range .Views}}
{{- if .Malformed}}
				{name: "a {{.Name}} body it cannot read", data: `{{.Malformed}}`},
{{- end}}
{{- end}}
			}
			for _, tt := range tests {
				t.Run(tt.name, func(t *testing.T) {
					t.Parallel()

					_, err := DecodeJSON([]byte(tt.data))
					assert.HasError(t, err, "an encoding it cannot place is refused")
				})
			}
		})

		t.Run("returns an error or a declaration that is a fixed point after one more trip", func(t *testing.T) {
			t.Parallel()

			prop.ForAll(t, jsonFixedPoint, decodesJSONFixed)
		})
	})

	t.Run("UnmarshalJSON", func(t *testing.T) {
		t.Parallel()

		t.Run("decodes each element through its kind", func(t *testing.T) {
			t.Parallel()

			subjects := Symbols{
{{- range .Views}}
				&{{.Name}}{},
{{- end}}
			}
			encoded, err := json.Marshal(subjects)
			assert.NoError(t, err, "the list marshals")

			var decoded Symbols
			assert.NoError(t, json.Unmarshal(encoded, &decoded), "and unmarshals")
			assert.Length(t, decoded, len(subjects), "whole")
			for i, want := range subjects {
				expect.Equal(t, decoded[i].Kind(), want.Kind(),
					"each element through its own kind")
			}
		})

		t.Run("decodes bytes that a plain interface slice returns an error for", func(t *testing.T) {
			t.Parallel()

			encoded, err := json.Marshal(Symbols{&{{(index .Views 0).Name}}{}})
			assert.NoError(t, err, "the list marshals")
			var plain []symbol.Symbol
			assert.HasError(t, json.Unmarshal(encoded, &plain),
				"a plain interface slice cannot decode the same bytes, "+
					"which is why Symbols exists")
		})

		t.Run("decodes null to a nil list", func(t *testing.T) {
			t.Parallel()

			decoded := Symbols{&{{(index .Views 0).Name}}{}}
			assert.NoError(t, json.Unmarshal([]byte("null"), &decoded),
				"null unmarshals")
			assert.Nil(t, decoded, "to nothing, so a value re-encodes as it arrived")

			one, err := DecodeJSON([]byte("null"))
			assert.NoError(t, err, "a null element decodes the way it encoded")
			assert.Nil(t, one, "to the nil declaration EncodeJSON produced it from")
		})

		t.Run("returns an error for an element it cannot place", func(t *testing.T) {
			t.Parallel()

			var decoded Symbols
			assert.HasError(t, json.Unmarshal([]byte(`[{"kind":"Nonexistent"}]`), &decoded),
				"an element it cannot place is refused")
			assert.HasError(t, json.Unmarshal([]byte(`{}`), &decoded),
				"and so is an encoding that is not a list")
		})

		t.Run("names the package in a list it cannot read", func(t *testing.T) {
			t.Parallel()

			var decoded Symbols
			err := decoded.UnmarshalJSON([]byte(`{}`))
			assert.HasError(t, err, "an object is no declaration list")
			assert.HasPrefix(t, err.Error(), "{{.Model}}: ", "under the package prefix")
		})
	})
}

// FuzzDecodeJSON checks [jsonFixedPoint] on bytes nothing in this
// repository produced. The encoding is a boundary: a sealed state and an
// encoded declaration arrive as bytes that a previous release, another
// tool or a corrupted file wrote. Each seed is the choices of one case: a
// two-byte little-endian length, then the bytes of the input.
func FuzzDecodeJSON(f *testing.F) {
	for _, seed := range []string{
{{- range .Views}}
		`{"kind":"{{.Name}}"}`,
{{- end}}
		`null`, `{}`, `[]`, `{"kind":"Nonexistent"}`,
	} {
		f.Add(append(binary.LittleEndian.AppendUint16(nil, uint16(len(seed))), seed...))
	}

	prop.Fuzz(f, jsonFixedPoint, decodesJSONFixed)
}

// The JSON codec allocates within its ceilings in the ordinary run,
// which runs no benchmark.
func TestSymbolsAllocs(t *testing.T) {
	for _, tt := range symbolsCases(t) {
		msg := tt.method + " for " + tt.name + " allocates within its ceiling"
		assert.MaxAllocs(t, tt.call, tt.allocs, msg)
		tt.check(t)
	}
}

// BenchmarkSymbols measures the JSON codec the conformance suites read
// declarations through.
func BenchmarkSymbols(b *testing.B) {
	for _, tt := range symbolsCases(b) {
		b.Run(tt.method, func(b *testing.B) {
			b.Run(tt.name, func(b *testing.B) {
				// The warm-up call caches the codec's functions for each
				// type and refills the pools the harness's collection
				// emptied.
				c := bench.Start(b).Warmup(1).MaxAllocs(tt.allocs)
				defer c.End()
				for c.Loop() {
					tt.call()
				}
				tt.check(b)
			})
		})
	}
}

// symbolsCases returns the codec's calls: {{if .Identified}}one
// package of the canonical shape for a declaration's encoding and
// decode{{else}}a subject of every kind for a declaration's encoding
// and decode{{end}}, and a list of every kind for a list's.
func symbolsCases(tb testing.TB) []symbolsCase {
	tb.Helper()

	list := symbolsList()
	listed, err := list.MarshalJSON()
	assert.NoError(tb, err, "the list encodes")
{{- if .Identified}}
	subjects := []symbol.Symbol{coretest.Workspace(1, symbolsFiles, symbolsDecls)[0]}
	corpus := "one package"
{{- else}}
	subjects := []symbol.Symbol(list)
	corpus := "every kind"
{{- end}}
	encoded := make([][]byte, 0, len(subjects))
	for _, s := range subjects {
		one, err := EncodeJSON(s)
		assert.NoError(tb, err, "the subject encodes")
		encoded = append(encoded, one)
	}
	var (
		decoded                                       symbol.Symbol
		marshalled                                    []byte
		unmarshalled                                  Symbols
		encodeErr, decodeErr, marshalErr, unmarshalErr error
	)
	return []symbolsCase{
		{
			method: "EncodeJSON",
			name:   corpus,
			allocs: symbolsEncodeAllocs + symbolsPoolAllocs,
			call: func() {
				encodeErr = nil
				for _, s := range subjects {
					if _, err := EncodeJSON(s); err != nil {
						encodeErr = err
					}
				}
			},
			check: func(tb testing.TB) { assert.NoError(tb, encodeErr, "every encoding succeeds") },
		},
		{
			method: "DecodeJSON",
			name:   corpus,
			allocs: symbolsDecodeAllocs + symbolsPoolAllocs,
			call: func() {
				decodeErr = nil
				for _, one := range encoded {
					if decoded, err = DecodeJSON(one); err != nil {
						decodeErr = err
					}
				}
			},
			check: func(tb testing.TB) {
				assert.NoError(tb, decodeErr, "every decode succeeds")
				assert.Equal(tb, decoded.Kind(), subjects[len(subjects)-1].Kind(), "to the kind that encoded it")
			},
		},
		{
			method: "Symbols.MarshalJSON",
			name:   "every kind",
			allocs: symbolsMarshalAllocs + symbolsPoolAllocs,
			call:   func() { marshalled, marshalErr = list.MarshalJSON() },
			check: func(tb testing.TB) {
				assert.NoError(tb, marshalErr, "every encoding succeeds")
				assert.Equal(tb, string(marshalled), string(listed), "to the list's encoding")
			},
		},
		{
			method: "Symbols.UnmarshalJSON",
			name:   "every kind",
			allocs: symbolsUnmarshalAllocs + symbolsPoolAllocs,
			call:   func() { unmarshalErr = unmarshalled.UnmarshalJSON(listed) },
			check: func(tb testing.TB) {
				assert.NoError(tb, unmarshalErr, "every decode succeeds")
				assert.Length(tb, unmarshalled, len(list), "to every kind")
			},
		},
	}
}

// decodesJSONFixed checks [jsonFixedPoint] on an input that the case
// draws. An input that does not decode satisfies it, and a declaration
// that decodes encodes to bytes that decode and encode to the same bytes
// again.
func decodesJSONFixed(c *prop.Case) {
	in := c.Draw(prop.Bytes(), "input")
	decoded, err := DecodeJSON(in)
	if err != nil {
		return
	}
	encoded, err := EncodeJSON(decoded)
	assert.NoError(c, err, "EncodeJSON must encode every declaration DecodeJSON returns")
	assert.RoundTrip(c, DecodeJSON, EncodeJSON, encoded, "a second trip must encode the same bytes")
}

// symbolsList returns a list of a subject of every kind, each with one
// child in every traversed field.
func symbolsList() Symbols {
	var out Symbols
{{- range .Views}}
	{
		subject := &{{.Name}}{}
{{- range .Children}}
		{{.}}
{{- end}}
		out = append(out, subject)
	}
{{- end}}
	return out
}
