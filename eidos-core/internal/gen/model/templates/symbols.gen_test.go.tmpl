import (
	"encoding/binary"
	"encoding/json"
	"errors"
	"testing"

	"go.dokimi.dev/assert"
	"go.dokimi.dev/assert/bench"
	"go.dokimi.dev/assert/expect"
	"go.dokimi.dev/assert/prop"
{{- if .Identified}}
	"go.dokimi.dev/eidos/core/internal/coretest"
{{- end}}
