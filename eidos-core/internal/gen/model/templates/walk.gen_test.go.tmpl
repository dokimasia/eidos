{{template "header" .}}
import (
	"testing"

{{if .Identified}}	"go.dokimi.dev/eidos/core/position"
{{end}}	"go.dokimi.dev/eidos/core/symbol"
)

func TestWalk(t *testing.T) {
	t.Parallel()

	t.Run("Walk", func(t *testing.T) {
		t.Parallel()

		t.Run("visits nothing for a nil declaration", func(t *testing.T) {
			t.Parallel()

			Walk(nil, func(symbol.Symbol) bool {
				t.Fatal("visit was called for a nil declaration")
				return true
			})
		})
{{- range .Views}}
{{- if .Children}}

		t.Run("descends into every traversed field of {{.Name}}", func(t *testing.T) {
			t.Parallel()

			subject := &{{.Name}}{}
{{- range .Children}}
			{{.}}
{{- end}}

			var seen int
			Walk(subject, func(symbol.Symbol) bool {
				seen++
				return true
			})
			if want := {{.WalkVisits}}; seen != want {
				t.Fatalf("visited %d declarations, want %d", seen, want)
			}
		})
{{- end}}
{{- end}}

		t.Run("prunes a subtree when visit answers false", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var seen int
				Walk(subject, func(symbol.Symbol) bool {
					seen++
					return false
				})
				if seen != 1 {
					t.Fatalf("visited %d declarations of {{.Name}} after pruning, want 1", seen)
				}
			}
{{- end}}
{{- end}}
		})
	})

	t.Run("All", func(t *testing.T) {
		t.Parallel()

		t.Run("yields the same declarations as Walk", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var walked int
				Walk(subject, func(symbol.Symbol) bool {
					walked++
					return true
				})
				var yielded int
				for range All(subject) {
					yielded++
				}
				if walked != yielded {
					t.Fatalf("All yielded %d {{.Name}} declarations, Walk visited %d",
						yielded, walked)
				}
			}
{{- end}}
{{- end}}
		})

		t.Run("stops when the range stops", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var yielded int
				for range All(subject) {
					yielded++
					break
				}
				if yielded != 1 {
					t.Fatalf("yielded %d {{.Name}} declarations after breaking, want 1", yielded)
				}
			}
{{- end}}
{{- end}}
		})
	})
{{- if .Identified}}

	t.Run("Declarations", func(t *testing.T) {
		t.Parallel()

		t.Run("yields every declaration All does", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var yielded int
				for range All(subject) {
					yielded++
				}
				var named int
				for range Declarations(subject) {
					named++
				}
				if named != yielded {
					t.Fatalf("Declarations yielded %d {{.Name}} declarations, All yielded %d",
						named, yielded)
				}
			}
{{- end}}
{{- end}}
		})

		t.Run("skips a symbol that does not name itself", func(t *testing.T) {
			t.Parallel()

			subject := &File{Decls: Symbols{unnamed{}}}
			for decl := range Declarations(subject) {
				if _, isFile := decl.(*File); !isFile {
					t.Fatalf("Declarations yielded %v, want the file alone", decl)
				}
			}
		})

		t.Run("stops when the range stops", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var yielded int
				for range Declarations(subject) {
					yielded++
					break
				}
				if yielded != 1 {
					t.Fatalf("yielded %d {{.Name}} declarations after breaking, want 1", yielded)
				}
			}
{{- end}}
{{- end}}
		})
	})
{{- end}}
}
{{- if .Identified}}

// unnamed is a symbol from outside this model: it answers the shared
// vocabulary and no identity, which is the only thing [Declarations]
// skips.
type unnamed struct{}

func (unnamed) Kind() symbol.Kind          { return symbol.KindInvalid }
func (unnamed) Position() position.Pos     { return position.Pos{} }
func (unnamed) Docs() []string             { return nil }
{{- end}}
