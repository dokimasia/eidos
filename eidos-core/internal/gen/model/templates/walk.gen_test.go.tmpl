{{template "header" .}}
import (
{{- if .Identified}}
	"strconv"
{{- end}}
	"testing"

	"go.dokimi.dev/assert"
	"go.dokimi.dev/assert/bench"
{{- if .Identified}}
	"go.dokimi.dev/eidos/core/internal/coretest"
	"go.dokimi.dev/eidos/core/position"
{{- end}}
	"go.dokimi.dev/eidos/core/symbol"
{{- template "model" .}}
)
{{- if .Identified}}

// The canonical scale every layer benches at: 1000 packages of 10
// files of 20 declarations, 200k declarations in all. The ordinary
// run checks the same ceilings over one package of the same shape.
const (
	walkPackages = 1000
	walkFiles    = 10
	walkDecls    = 20
)
{{- else}}

// walkVisits is what a walk over every kind's populated subject
// visits: each subject and the one child in each of its traversed
// fields.
const walkVisits = 0{{range .Views}} + {{.WalkVisits}}{{end}}

// walkOriginated is how many kinds carry origin storage.
const walkOriginated = 0{{range .Views}}{{if .OriginStorage}} + 1{{end}}{{end}}
{{- end}}

// walkCase is one measured traversal: the function it calls and the
// case it measures, which name its sub-benchmark, the call, and the
// check on what the last call visited. A traversal allocates nothing.
type walkCase struct {
	method string
	name   string
	call   func()
	check  func(testing.TB)
}
{{- if .Identified}}

// unnamed is a symbol from outside this model: it satisfies the shared
// vocabulary and no identity, which is the only thing [Declarations]
// skips.
type unnamed struct{}

// Kind returns the invalid kind.
func (unnamed) Kind() symbol.Kind { return symbol.KindInvalid }

// Position returns the zero position.
func (unnamed) Position() position.Pos { return position.Pos{} }

// Docs returns nil.
func (unnamed) Docs() []string { return nil }
{{- end}}

// The traversals visit every declaration a subject contains, prune
// where the visit says so, and stop where the range stops.
func TestWalk(t *testing.T) {
	t.Parallel()

	t.Run("Walk", func(t *testing.T) {
		t.Parallel()

		t.Run("visits nothing for a nil declaration", func(t *testing.T) {
			t.Parallel()

			Walk(nil, func(symbol.Symbol) bool {
				assert.True(t, false, "visit is never called for a nil declaration")
				return true
			})
		})
{{- range .Views}}
{{- if .Children}}

		t.Run("descends into every traversed field of {{.Name}}", func(t *testing.T) {
			t.Parallel()

			subject := &{{.Name}}{}
{{- range .Children}}
			{{.}}
{{- end}}

			var seen int
			Walk(subject, func(symbol.Symbol) bool {
				seen++
				return true
			})
			assert.Equal(t, seen, {{.WalkVisits}},
				"the walk descends into every traversed field")
		})
{{- end}}
{{- end}}

		t.Run("prunes a subtree when visit returns false", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var seen int
				Walk(subject, func(symbol.Symbol) bool {
					seen++
					return false
				})
				assert.Equal(t, seen, 1,
					"returning false prunes the subtree")
			}
{{- end}}
{{- end}}
		})
	})

	t.Run("All", func(t *testing.T) {
		t.Parallel()

		t.Run("yields the same declarations as Walk", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var walked int
				Walk(subject, func(symbol.Symbol) bool {
					walked++
					return true
				})
				var yielded int
				for range All(subject) {
					yielded++
				}
				assert.Equal(t, yielded, walked,
					"All yields the same declarations Walk visits")
			}
{{- end}}
{{- end}}
		})

		t.Run("stops when the range stops", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var yielded int
				for range All(subject) {
					yielded++
					break
				}
				assert.Equal(t, yielded, 1,
					"the iteration stops when the range stops")
			}
{{- end}}
{{- end}}
		})

		t.Run("stops the whole walk at a break", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if ge .WalkVisits 3}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var yielded int
				for range All(subject) {
					yielded++
					if yielded == 2 {
						break
					}
				}
				assert.Equal(t, yielded, 2,
					"a stopped range yields nothing more, though the walk beneath "+
						"it carries on to the siblings a pruned subtree left")
			}
{{- end}}
{{- end}}
		})
	})
{{- if .Originated}}

	t.Run("OriginOf", func(t *testing.T) {
		t.Parallel()
{{- range .Views}}

		t.Run("reports {{if .OriginStorage}}true{{else}}false{{end}} for {{.Name}}", func(t *testing.T) {
			t.Parallel()

			_, held := OriginOf(&{{.Name}}{})
			assert.{{if .OriginStorage}}True{{else}}False{{end}}(t, held,
				"a kind reports true exactly when it carries origin storage")
		})
{{- end}}
	})
{{- end}}
{{- if .Identified}}

	t.Run("Declarations", func(t *testing.T) {
		t.Parallel()

		t.Run("yields every declaration All does", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var yielded int
				for range All(subject) {
					yielded++
				}
				var named int
				for range Declarations(subject) {
					named++
				}
				assert.Equal(t, named, yielded,
					"Declarations yields every declaration All does")
			}
{{- end}}
{{- end}}
		})

		t.Run("skips a symbol that does not name itself", func(t *testing.T) {
			t.Parallel()

			subject := &File{Decls: Symbols{unnamed{}}}
			for decl := range Declarations(subject) {
				_, isFile := decl.(*File)
				assert.True(t, isFile,
					"a symbol that does not name itself is skipped, not yielded")
			}
		})

		t.Run("stops when the range stops", func(t *testing.T) {
			t.Parallel()
{{- range .Views}}
{{- if .Children}}

			{
				subject := &{{.Name}}{}
{{- range .Children}}
				{{.}}
{{- end}}
				var yielded int
				for range Declarations(subject) {
					yielded++
					break
				}
				assert.Equal(t, yielded, 1,
					"the typed iteration stops when the range stops")
			}
{{- end}}
{{- end}}
		})
	})
{{- end}}
}

// The traversals allocate nothing in the ordinary run, which runs no
// benchmark.
func TestWalkAllocs(t *testing.T) {
	for _, tt := range walkCases({{if .Identified}}1{{end}}) {
		assert.MaxAllocs(t, tt.call, 0, tt.method+" for "+tt.name+" allocates nothing")
		tt.check(t)
	}
}

// BenchmarkWalk measures the traversals every projection and every
// generator runs over the model.
func BenchmarkWalk(b *testing.B) {
	for _, tt := range walkCases({{if .Identified}}walkPackages{{end}}) {
		b.Run(tt.method, func(b *testing.B) {
			b.Run(tt.name, func(b *testing.B) {
				// The first call runs before the contract counts, at the
				// call site it measures, where the runtime builds the
				// caches of an inlined iterator's conversion sites.
				tt.call()
				c := bench.Start(b).MaxAllocs(0)
				defer c.End()
				for c.Loop() {
					tt.call()
				}
				tt.check(b)
			})
		})
	}
}
{{- if .Identified}}

// walkCases returns the traversals over a corpus of the given number
// of packages, which builds once and is shared: what a case measures
// is the walk, not the fixture.
//
// Every case compares its count against what the corpus contains:
// each package, each of its files, and each declaration in them. A
// range over an iterator inlines, so a walk that stopped visiting the
// graph would still report a plausible time and no allocations. Only
// the count shows that the work happened.
func walkCases(packages int) []walkCase {
	pkgs := coretest.Workspace(packages, walkFiles, walkDecls)
	want := packages + packages*walkFiles + packages*walkFiles*walkDecls
	corpus := "a corpus of " + strconv.Itoa(packages*walkFiles*walkDecls) + " declarations"
	var seen int
	visit := func(symbol.Symbol) bool {
		seen++
		return true
	}
	visited := func(tb testing.TB) {
		assert.Equal(tb, seen, want, "the traversal visits every symbol of the corpus")
	}
	return []walkCase{
		{
			method: "Walk", name: corpus,
			call: func() {
				seen = 0
				for _, pkg := range pkgs {
					Walk(pkg, visit)
				}
			},
			check: visited,
		},
		{
			method: "All", name: corpus,
			call: func() {
				seen = 0
				for _, pkg := range pkgs {
					for range All(pkg) {
						seen++
					}
				}
			},
			check: visited,
		},
		{
			method: "Declarations", name: corpus,
			call: func() {
				seen = 0
				for _, pkg := range pkgs {
					for range Declarations(pkg) {
						seen++
					}
				}
			},
			check: visited,
		},
	}
}
{{- else}}

// walkCases returns the traversals over a subject of every kind, each
// with one child in every traversed field.
func walkCases() []walkCase {
	subjects := walkSubjects()
	var seen, held int
	visit := func(symbol.Symbol) bool {
		seen++
		return true
	}
	visited := func(tb testing.TB) {
		assert.Equal(tb, seen, walkVisits, "the traversal visits every subject and every child")
	}
	return []walkCase{
		{
			method: "Walk", name: "every kind",
			call: func() {
				seen = 0
				for _, s := range subjects {
					Walk(s, visit)
				}
			},
			check: visited,
		},
		{
			method: "All", name: "every kind",
			call: func() {
				seen = 0
				for _, s := range subjects {
					for range All(s) {
						seen++
					}
				}
			},
			check: visited,
		},
		{
			method: "OriginOf", name: "every kind",
			call: func() {
				held = 0
				for _, s := range subjects {
					if _, carries := OriginOf(s); carries {
						held++
					}
				}
			},
			check: func(tb testing.TB) {
				assert.Equal(tb, held, walkOriginated, "OriginOf reports true for every kind with origin storage")
			},
		},
	}
}

// walkSubjects returns a subject of every kind, each with one child in
// every traversed field.
func walkSubjects() []symbol.Symbol {
	var out []symbol.Symbol
{{- range .Views}}
	{
		subject := &{{.Name}}{}
{{- range .Children}}
		{{.}}
{{- end}}
		out = append(out, subject)
	}
{{- end}}
	return out
}
{{- end}}
