{{template "header" .}}
import (
	"iter"

	"go.dokimi.dev/eidos/core/symbol"
)

// Walk visits s and every declaration it contains, depth first, in
// schema field order.
//
// Returning false from visit prunes that subtree and continues.
// Walk follows only containment edges, so the walk is a tree although
// the graph is not. It never traverses a back-pointer, and a
// cross-reference is an identity and not a pointer.
func Walk(s symbol.Symbol, visit func(symbol.Symbol) bool) {
	if s == nil || !visit(s) {
		return
	}
	switch x := s.(type) {
{{- range .Views}}
{{- if .Walked}}
	case *{{.Name}}:
{{- range .Walked}}
{{- if .Slice}}
		for _, child := range {{.Items}} {
			Walk(child, visit)
		}
{{- else}}
		if x.{{.Storage}} != nil {
			Walk(x.{{.Storage}}, visit)
		}
{{- end}}
{{- end}}
{{- end}}
{{- end}}
	}
}

// All returns the traversal of [Walk] as an iterator.
//
// A break out of the range stops the whole walk. In [Walk], a visit
// that returns false prunes only one subtree.
func All(s symbol.Symbol) iter.Seq[symbol.Symbol] {
	return func(yield func(symbol.Symbol) bool) {
		stopped := false
		Walk(s, func(n symbol.Symbol) bool {
			if stopped {
				return false
			}
			if !yield(n) {
				stopped = true
				return false
			}
			return true
		})
	}
}
{{- if .Originated}}

// OriginOf returns the node identity that a generated value derives
// from. It returns false for a kind without origin storage. It returns
// true for a kind with origin storage, also when the identity is zero.
func OriginOf(s symbol.Symbol) (symbol.Identity, bool) {
	switch x := s.(type) {
{{- range .Views}}
{{- if .OriginStorage}}
	case *{{.Name}}:
		return x.{{.OriginStorage}}, true
{{- end}}
{{- end}}
	default:
		return symbol.Identity{}, false
	}
}
{{- end}}
{{- if .Identified}}

// Declaration is a node that returns a canonical identity.
//
// Every kind on this side satisfies it. A field of type [Symbols]
// admits any symbol, so a traversal yields [symbol.Symbol] values.
// Declaration gives a caller the identity of each value without a
// type switch.
type Declaration interface {
	symbol.Symbol

	// Identity returns the canonical identity of the declaration. It
	// is zero until the resolution step assigns one. A kind without an
	// identity field always returns the zero identity.
	Identity() symbol.Identity
}

// Declarations returns the traversal of [All] as a sequence of
// [Declaration] values.
//
// Declarations skips a symbol that does not implement [Declaration].
// Only a foreign implementation in a [Symbols] field can be such a
// symbol. The walk still visits its subtree, because containment does
// not depend on identity.
func Declarations(s symbol.Symbol) iter.Seq[Declaration] {
	return func(yield func(Declaration) bool) {
		for child := range All(s) {
			decl, names := child.(Declaration)
			if !names {
				continue
			}
			if !yield(decl) {
				return
			}
		}
	}
}
{{- end}}
