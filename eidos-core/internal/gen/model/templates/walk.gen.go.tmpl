{{template "header" .}}
import (
	"iter"

	"go.dokimi.dev/eidos/core/symbol"
)

// Walk visits s and every declaration it contains, depth first, in
// schema field order.
//
// Returning false from visit prunes that subtree and continues.
// Only containment edges are followed, so the walk is a tree even
// though the graph is not: a back-pointer is never traversed, and a
// cross-reference is an identity rather than a pointer.
func Walk(s symbol.Symbol, visit func(symbol.Symbol) bool) {
	if s == nil || !visit(s) {
		return
	}
	switch x := s.(type) {
{{- range .Views}}
{{- if .Walked}}
	case *{{.Name}}:
{{- range .Walked}}
{{- if .Slice}}
		for _, child := range {{.Items}} {
			Walk(child, visit)
		}
{{- else}}
		if x.{{.Storage}} != nil {
			Walk(x.{{.Storage}}, visit)
		}
{{- end}}
{{- end}}
{{- end}}
{{- end}}
	}
}

// All answers the same traversal as [Walk] as an iterator.
//
// Stopping the range stops the walk, which differs from Walk's own
// visit: there, false prunes one subtree.
func All(s symbol.Symbol) iter.Seq[symbol.Symbol] {
	return func(yield func(symbol.Symbol) bool) {
		stopped := false
		Walk(s, func(n symbol.Symbol) bool {
			if stopped {
				return false
			}
			if !yield(n) {
				stopped = true
				return false
			}
			return true
		})
	}
}
{{- if .Originated}}

// OriginOf answers the node identity a generated value derives
// from, and false for a kind that carries no origin storage. The
// zero identity still answers true, and claims nothing: carrying
// the seat and carrying a value are different questions.
func OriginOf(s symbol.Symbol) (symbol.Identity, bool) {
	switch x := s.(type) {
{{- range .Views}}
{{- if .OriginStorage}}
	case *{{.Name}}:
		return x.{{.OriginStorage}}, true
{{- end}}
{{- end}}
	default:
		return symbol.Identity{}, false
	}
}
{{- end}}
{{- if .Identified}}

// Declaration is a declaration that names itself.
//
// Every kind on this side answers it. The interface exists because
// the fields typed [Symbols] admit any symbol, so a traversal is
// statically a sequence of [symbol.Symbol] even where every element
// is one of these.
type Declaration interface {
	symbol.Symbol

	// Identity answers the declaration's canonical identity, which
	// stays zero until the resolution step assigns one.
	Identity() symbol.Identity
}

// Declarations answers the traversal [All] makes, typed as the
// declarations it yields.
//
// A symbol that does not name itself is skipped rather than
// answered, which only a foreign implementation placed in a
// [Symbols] field can be. Its subtree still walks, because
// containment does not depend on identity.
func Declarations(s symbol.Symbol) iter.Seq[Declaration] {
	return func(yield func(Declaration) bool) {
		for child := range All(s) {
			decl, names := child.(Declaration)
			if !names {
				continue
			}
			if !yield(decl) {
				return
			}
		}
	}
}
{{- end}}
