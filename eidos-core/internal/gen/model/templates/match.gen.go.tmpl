{{template "header" .}}
import (
	"go.dokimi.dev/eidos/core/node"
	"go.dokimi.dev/eidos/core/symbol"
)
{{- range .Views}}
{{- if .Subject}}

// {{.Name}}Match is the On{{.Name}} subject.
type {{.Name}}Match struct {
	match
	{{.Name}} *node.{{.Name}}
}

// unbind zeroes the match for its lane's next phase call, and returns
// the key the lane keeps released {{.Name}}Match values under.
func (m *{{.Name}}Match) unbind() any {
	*m = {{.Name}}Match{}
	return (*{{.Name}}Match)(nil)
}

// On{{.Name}} fires the handler once per subject of its kind in
// scope, or once per gating instance under a Directive wrapper.
// The effect parameter picks the role: an Emitter generates, a
// Stamper annotates.
func On{{.Name}}[E Effect](h func(*{{.Name}}Match, E) error) Rule {
	return Rule{leaf: &leaf{
		kind:  symbol.Kind{{.Name}},
		phase: phaseOf[E](),
		invoke: func(inv invocation) error {
			decl, held := inv.value.(*node.{{.Name}})
			if !held {
				return nil
			}
			m := bindMatch[{{.Name}}Match](inv)
			m.{{.Name}} = decl
			return h(m, effectFor[E](inv.rs, &m.match))
		},
	}}
}
{{- end}}
{{- end}}
