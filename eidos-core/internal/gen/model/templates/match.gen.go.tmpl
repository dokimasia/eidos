{{template "header" .}}
import (
	"go.dokimi.dev/eidos/core/node"
	"go.dokimi.dev/eidos/core/symbol"
)
{{- range .Views}}
{{- if .Subject}}

// {{.Name}}Match is the On{{.Name}} subject.
type {{.Name}}Match struct {
	subjectMatch
	{{.Name}} *node.{{.Name}}
}

var _ SubjectMatch = (*{{.Name}}Match)(nil)

// unbind zeroes the match for the next phase call of its lane, and
// returns the key under which the lane keeps released {{.Name}}Match
// values.
func (m *{{.Name}}Match) unbind() any {
	*m = {{.Name}}Match{}
	return (*{{.Name}}Match)(nil)
}

// On{{.Name}} runs the handler once for each subject of its kind in
// scope, or once for each gating instance under a Directive wrapper.
// The effect parameter selects the role. An Emitter generates, and a
// Stamper annotates.
func On{{.Name}}[E Effect](h func(*{{.Name}}Match, E) error) Rule {
	return Rule{leaf: &leaf{
		kind:  symbol.Kind{{.Name}},
		phase: phaseOf[E](),
		invoke: func(inv invocation) error {
			decl, held := inv.value.(*node.{{.Name}})
			if !held {
				return nil
			}
			m := bindMatch[{{.Name}}Match](inv)
			m.{{.Name}} = decl
			return h(m, effectFor[E](inv.rs, &m.match))
		},
	}}
}
{{- end}}
{{- end}}
